@{
    ViewData["Title"] = "Panoramica";
}

<section class="cm-page-heading">
    <div>
        <span class="cm-eyebrow">WORKSPACE / PANORAMICA</span>
        <h1>Il tuo catalogo, sotto controllo.</h1>
        <p>Gestisci l'anagrafica dei prodotti, le categorie e i fornitori da un unico spazio di lavoro.</p>
    </div>
</section>

<section class="cm-hero mb-4" aria-label="Presentazione CatalogManager">
    <div class="cm-hero-content">
        <span class="cm-hero-kicker">CATALOG MANAGEMENT</span>
        <h2>Una base ordinata per il tuo catalogo aziendale.</h2>
        <p>Partiamo dalle categorie. Collegheremo poi prodotti e fornitori, con prezzi di acquisto specifici per ciascuna associazione.</p>
        <a asp-controller="Categories" asp-action="Index" class="btn cm-btn-light">Gestisci le categorie <span aria-hidden="true">↗</span></a>
    </div>
    <div class="cm-hero-pattern" aria-hidden="true">
        <div class="cm-pattern-card cm-pattern-one">PRODOTTI</div>
        <div class="cm-pattern-card cm-pattern-two">CATEGORIE</div>
        <div class="cm-pattern-card cm-pattern-three">FORNITORI</div>
    </div>
</section>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <section class="cm-panel h-100">
            <div class="cm-panel-header">
                <div>
                    <span class="cm-eyebrow">AREE DI LAVORO</span>
                    <h2>Da dove iniziamo?</h2>
                </div>
            </div>

            <a asp-controller="Categories" asp-action="Index" class="cm-feature-row cm-feature-action">
                <span class="cm-feature-icon">CA</span>
                <span class="cm-feature-copy">
                    <strong>Categorie</strong>
                    <small>Crea e organizza le categorie del catalogo.</small>
                </span>
                <span class="cm-state cm-state-ready">Disponibile</span>
            </a>
            <div class="cm-feature-row">
                <span class="cm-feature-icon">PR</span>
                <span class="cm-feature-copy">
                    <strong>Prodotti</strong>
                    <small>Anagrafica, prezzo di vendita e categoria associata.</small>
                </span>
                <span class="cm-state">Da sviluppare</span>
            </div>
            <div class="cm-feature-row">
                <span class="cm-feature-icon">FO</span>
                <span class="cm-feature-copy">
                    <strong>Fornitori</strong>
                    <small>Gestione anagrafica e condizioni di acquisto.</small>
                </span>
                <span class="cm-state">Da sviluppare</span>
            </div>
        </section>
    </div>

    <div class="col-12 col-lg-5">
        <section class="cm-panel h-100">
            <div class="cm-panel-header">
                <div>
                    <span class="cm-eyebrow">MODELLO DATI</span>
                    <h2>Come si collegano?</h2>
                </div>
            </div>
            <div class="cm-domain-stack">
                <div class="cm-domain-node"><strong>Category</strong><small>1 categoria → più prodotti</small></div>
                <div class="cm-domain-connector">↓</div>
                <div class="cm-domain-node"><strong>Product</strong><small>Prezzo di vendita e anagrafica</small></div>
                <div class="cm-domain-connector">↓</div>
                <div class="cm-domain-node cm-domain-node-highlight"><strong>ProductSupplier</strong><small>Associazione con prezzo di acquisto</small></div>
                <div class="cm-domain-connector">↓</div>
                <div class="cm-domain-node"><strong>Supplier</strong><small>Fornitore del prodotto</small></div>
            </div>
            <p class="cm-help-text mt-3 mb-0">Schema concettuale semplificato delle entità già definite; non rappresenta dati inseriti nel database.</p>
        </section>
    </div>
</div>
