@model CatalogManager.Models.Category

@{
    ViewData["Title"] = "Nuova categoria";
}

<section class="cm-page-heading">
    <a asp-action="Index" class="cm-back-link">← Torna alle categorie</a>
    <span class="cm-eyebrow">CATALOGO / CATEGORIE / NUOVA</span>
    <h1>Nuova categoria</h1>
    <p>Aggiungi una nuova categoria per organizzare i prodotti del catalogo.</p>
</section>

<div class="row g-4">
    <div class="col-12 col-xl-7">
        <section class="cm-panel cm-form-panel">
            <div class="cm-panel-header">
                <div>
                    <h2>Informazioni categoria</h2>
                    <p>Inserisci i dati necessari per creare la categoria.</p>
                </div>
            </div>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <div class="mb-4">
                    <label asp-for="Name" class="form-label cm-field-label">Nome categoria</label>
                    <input asp-for="Name" class="form-control cm-control"
                           maxlength="100" placeholder="Es. Periferiche" autocomplete="off" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                    <div class="cm-field-help">Utilizza un nome chiaro e riconoscibile. Massimo 100 caratteri.</div>
                </div>
                <div class="cm-form-actions">
                    <a asp-action="Index" class="btn cm-btn-secondary">Annulla</a>
                    <button type="submit" class="btn cm-btn-primary">Crea categoria</button>
                </div>
            </form>
        </section>
    </div>
    <div class="col-12 col-xl-5">
        <aside class="cm-tip-card">
            <span class="cm-tip-icon" aria-hidden="true">i</span>
            <h2>Perché creare una categoria?</h2>
            <p>Ogni prodotto del nostro catalogo apparterrà a una categoria. La stessa categoria potrà essere utilizzata da più prodotti.</p>
            <p class="mb-0">Le associazioni ai prodotti verranno gestite successivamente, nella sezione Prodotti.</p>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
